# RackForge live bot (systemd user unit template).
# Replace @RACKFORGE_DIR@ with the absolute path of this checkout and @NODE@ with the
# node binary (Node 22.5+), then:
#   cp deploy/rackforge-bot.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now rackforge-bot
# Credentials: the first run needs BOT_TOKEN or BOT_NONCE (see src/bot.ts);
# afterwards the token is kept in @RACKFORGE_DIR@/.token-<BOT_NAME> (mode 600). Do
# not put tokens in this file.
[Unit]
Description=RackForge ScrabbleBot
After=network-online.target rackforge-stdb.service

[Service]
WorkingDirectory=@RACKFORGE_DIR@
Environment=BOT_NAME=rackforge
# Opponent model: the miner's working copy (default: data/history.sqlite).
Environment=RACKFORGE_MODEL_DB=@RACKFORGE_DIR@/data/miner.sqlite
# Optional: tournament-only mode, never join the ladder lobby.
#Environment=RACKFORGE_NO_LADDER=1
ExecStart=@NODE@ @RACKFORGE_DIR@/node_modules/tsx/dist/cli.mjs src/bot.ts --agent rackforge
Restart=always
RestartSec=5
StandardOutput=append:@RACKFORGE_DIR@/logs/bot.log
StandardError=append:@RACKFORGE_DIR@/logs/bot.log

[Install]
WantedBy=default.target
